@article{pAdvancementsSoilMoisture2025,
  title = {Advancements in Soil Moisture Estimation through Integration of Remote Sensing and Artificial Intelligence Techniques},
  author = {P, S.; Joshi, S.K.; Asirvatham, L.G.; Rakshith, B.L., H.; Gautam},
  year = 2025,
  journal = {Science of the Total Environment},
  volume = {1001},
  doi = {10.1016/j.scitotenv.2025.180503},
  abstract = {Soil moisture plays a vital role in crop productivity, ecosystem function, climate feedback, and groundwater recharge, yet it remains one of the least directly measured hydrological and hydrogeological variables. Its limitations in spatial coverage, depth sensitivity, and real-time monitoring hinder the soil moisture estimation methods. This review presents a comprehensive overview of recent advancements in soil moisture estimation techniques, covering traditional in-situ, remote sensing, and AI-based methods. A comparative evaluation highlights these methods' operational mechanisms, spatial limitations, and potential synergies with region-specific insights. It also summarizes approaches such as cosmic-ray neutron sensing, Global Navigation Satellite System (GNSS) reflectometry, Synthetic Aperture Radar (SAR) based methods, and multi-sensor data fusion for large-scale surface soil moisture estimation. The present study highlights the key challenges, such as physical interpretability, transparency, and model transferability in AI-based models due to their black-box nature. Incorporation of remote sensing with explainable AI further enhances the performance, trustworthiness, and reliability of the model. In addition, integrating multi-sensor data with in-situ data, machine/deep learning, and physical models enhances the accuracy, spatial and temporal resolution, continuous data availability, and root zone soil moisture estimation. Further research is required in uncertainty handling, evaluating, validating, and improving the transferability of the model across diverse regions. Through citizen science and crowdsourcing, real-time soil moisture monitoring in the data-scarce areas can be achieved. The study concludes by outlining future directions for scalable, interpretable monitoring systems and developing robust systems to support sustainable water resource management and climate-resilient agriculture. \copyright{} 2025 Elsevier B.V.},
  langid = {english},
  keywords = {agriculture,Agriculture,artificial intelligence,Artificial intelligence,Artificial intelligence techniques,Climate feedbacks,comparative study,controlled study,cosmic radiation,Cosmology,Crop productivity,crowdsourcing,Data fusion,Data integration,deep learning,Deep learning,Distributed computer systems,Ecosystem functions,Ecosystems,explainable artificial intelligence,global navigation satellite system,GNSS,ground water,Ground water recharge,Groundwater,Hydrogeology,Hydrological monitoring,Learning systems,machine learning,moisture,monitoring,nonhuman,physical model,plant root,reflectometry,reliability,remote sensing,Remote sensing,Remote-sensing,review,sensor,Sensor data fusion,soil moisture,Soil moisture,Soil moisture estimation,Soil surveys,surface soil,synthetic aperture radar,trustworthiness,Water conservation,water supply}
}

