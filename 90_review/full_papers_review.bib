@article{Behura2025,
  title = {Comprehensive Analysis of Methods for Estimating Actual Paddy Evapotranspiration---{{A}} Review},
  author = {Behura, Kiran Bala and Raul, Sanjay Kumar and Paul, Jagadish Chandra and Mohanty, Sheelabhadra and Jena, Prachi Pratyasha and Dwibedi, Sanat Kumar and Ghosh, Subhankar and Singh, Laishram Kanta and Devi, Sougrakpam Roma and Singha, Arun Kumar and Mohanty, Amulya Kumar},
  year = 2025,
  month = mar,
  journal = {Frontiers in Water},
  volume = {7},
  publisher = {Frontiers},
  issn = {2624-9375},
  doi = {10.3389/frwa.2025.1553732},
  urldate = {2026-07-07},
  abstract = {Evapotranspiration (ET) has considerable significance in the water cycle, especially in farming areas where it determines crop water needs, irrigation plans, and sustainable management of water resources. This study stresses the need for accurate ET estimation in paddy fields where rice is grown because of its high-water sensitivity and consumption which has implications for water use efficiency and food security. The study attempts to address the problem by estimating rice ET: Standard procedures such as the Penman--Monteith equation, lysimeters, and even remote sensing procedures such as Surface Energy Balance Algorithm for Land (SEBAL) and Mapping Evapotranspiration at High Resolution with Internalized Calibration (METRIC) are all investigated. Furthermore, an attempt is made to combine remote sensing data with machine learning techniques for refined ET estimation. Utilizing modernized technologies and hybrid models, the research investigation aims to deepen the understanding of ET variability for rice cropping systems to promote improved water resources management and sustainable agriculture practices as areas for future work suggest the application of vegetation indices incorporating high-resolution multi-spectral imagery to accurately estimate ET and appropriately differentiate between evaporation and transpiration in these complex agricultural systems.},
  langid = {english},
  keywords = {CROP EVAPOTRANSPIRATION,direct ET estimation,ENERGY BALANCE ALGORITHMS,Internet of Things,LAND-SURFACE TEMPERATURE,machine learning,MACHINE LEARNING ALGORITHMS,MAPPING EVAPOTRANSPIRATION,METRIC,paddy evapotranspiration,remote sensing,RICE EVAPOTRANSPIRATION,SEBAL,SEBAL MODEL,SOIL-MOISTURE,SUPPORT VECTOR MACHINE,water balance,WATER-USE EFFICIENCY},
  file = {C\:\\Users\\lenka\\Zotero\\storage\\27XMKRVJ\\Behura et al. - 2025 - Comprehensive analysis of methods for estimating actual paddy evapotranspiration—A review.pdf;C\:\\Users\\lenka\\Zotero\\storage\\EUCTGZTF\\Behura - 2025 - Comprehensive analysis of methods for estimating actual paddy evapotranspiration-A review.pdf}
}

