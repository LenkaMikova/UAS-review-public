@article{bhavanaIntegratedDeepLearning2025,
  title = {Integrated {{Deep Learning Framework}} for {{Precision Crop Yield Prediction Using Satellite Imagery}} and {{Real-Time Environmental Data}}},
  author = {Bhavana, M.; Kanchana, R.; Samhitha, D.; Deekshitha, D.; Vaishnavi, K., K.; Rishika},
  year = 2025,
  journal = {2025 3rd International Conference on Communication, Security, and Artificial Intelligence, ICCSAI 2025},
  pages = {1278--1283},
  doi = {10.1109/ICCSAI64074.2025.11063779},
  abstract = {Crop yield prediction is an important for global food security, particularly in a climate of growing populations, resource constraints, and a changing climate. Traditional methods of crop yield prediction have proven inaccurate, as crop types, agricultural practices, and environmental factors interact complexly. New advances in machine learning, satellite technology, and sensor-based data collection are expected to have a high degree of success in increasing the precision of crop yield predictions. This paper reviews and offers an integrated approach for predicting crop yield using deep learning models combined with satellite imagery along with real-time environmental data. We discuss major algorithms involved in processing and analyzing big data to improve precision in crop yield prediction using techniques including ANN, LSTM, and CNN. We also provide an approach that integrates the use of ensemble models and climate data along with precision agriculture technologies in optimizing resource utilization and better farming practices. The proposed model combines several data sources on weather condition, soil moisture levels, and satellite imaging to ensure scalability and sustainability that crop yield forecasting lacks. Further directions also include genetic engineering, nanotechnology, and reinforcement learning for refinement of the predictive models leading to further development in sustainability in agricultural production.  \copyright{} 2025 IEEE.},
  langid = {english},
  keywords = {Agricultural machinery,ANN (Artificial Neural Networks),Artificial neural network,Big data,CNN (Convolution Neural Networks),Convolution neural network,Crop yield,Crops,Deep learning,Deep Learning,Deep neural networks,Ensemble Model,Ensemble models,Forecasting,Genetic engineering,Genetic Engineering,Learning systems,Long-short term memory,LSTM (Long-Short Term Memory),Nanotechnology,Neural-networks,Precision agriculture,Reinforcement Learning,Reinforcement learnings,Satellite imagery,Short term memory,Sustainable development}
}

@article{Bogena2022,
  title = {Recent {{Developments}} in {{Wireless Soil Moisture Sensing}} to {{Support Scientific Research}} and {{Agricultural Management}}},
  author = {Bogena, Heye Reemt and Weuthen, Ansgar and Huisman, Johan Alexander},
  year = 2022,
  journal = {Sensors},
  volume = {22},
  number = {24},
  publisher = {MDPI},
  issn = {1424-8220},
  doi = {10.3390/s22249792},
  abstract = {In recent years, wireless sensor network (WSN) technology has emerged as an important technique for wireless sensing of soil moisture from the field to the catchment scale. This review paper presents the current status of wireless sensor network (WSN) technology for distributed, near real-time sensing of soil moisture to investigate seasonal and event dynamics of soil moisture patterns. It is also discussed how WSN measurements of soil measurements contribute to the validation and downscaling of satellite data and non-invasive geophysical instruments as well as the validation of distributed hydrological models. Finally, future perspectives for WSN measurements of soil moisture are highlighted, which includes the improved integration of real-time WSN measurements with other information sources using the latest wireless communication techniques and cyberinfrastructures. \copyright{} 2022 by the authors.},
  langid = {english},
  keywords = {agriculture,Agriculture,Catchment scale,Catchments,cyberinfrastructure,Cyberinfrastructure,field and catchment scale,Field scale,hydrological modelling,Hydrological models,chemistry,Moisture control,procedures,remote sensing,Remote sensing,Remote Sensing Technology,Remote-sensing,Runoff,Sensor network measurement,Sensor network technology,sensor validation,Sensor validation,soil,Soil,Soil moisture,soil moisture sensing,Soil moisture sensing,Soil surveys,wireless communication,wireless communication technology,Wireless communication technology,Wireless sensor networks,Wireless Technology},
