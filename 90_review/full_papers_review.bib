@incollection{Goel2026,
  title = {Passive and Active Smart Farming for Remote and Proximal Sensing of Wildlife Deterrence},
  booktitle = {Robotics and {{Intelligent Machines}} in {{Smart Agriculture}}: {{Emerging Systems}} and {{Applications}}},
  author = {Goel, Sonali and Sharma, Renu and Varanasi, Lakshmi Narasimha Sastry and Krishna, Vanka Bala Murali},
  editor = {Shabaz, Mohammad},
  year = 2026,
  pages = {141--167},
  publisher = {CRC Press},
  doi = {10.1201/9781003562627-7},
  abstract = {Agricultural crop monitoring, from sowing to harvesting, is crucial for boosting production and productivity. Crop losses are often caused by factors such as soil moisture levels, timely irrigation, pest control, weed management, and damage from wild animals. Farmers have implemented various measures to address crop damage, and smart farming offers a way to reduce losses by enhancing productivity and income. This paper reviews previous global research on the use of sensor systems for monitoring crop growth and addressing damage caused by wild animals during harvesting. The study highlights that integrating modern technologies like IoT, AI, robotics, and UAVs into agriculture can optimize farming practices. These technologies provide real-time data on crop health, soil conditions, and pest activity, supporting sustainable farming practices. \copyright{} 2026 selection and editorial matter, Mohammad Shabaz; individual chapters, the contributors.},
  isbn = {978-1-040-55247-6},
  langid = {english},
  keywords = {Agribusiness,Agricultural crops,Animals,AS-soils,Crop loss,Crop monitoring,Crops,Damage detection,Farming practices,Livestock,Moisture level,Proximal sensing,Remote-sensing,Smart agriculture,Soil moisture,Weed control,Weed management,Wild animals},
  file = {C:\Users\lenka\Zotero\storage\H3RR4R6E\105031903338.html}
}

