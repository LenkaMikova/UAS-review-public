@article{P2025,
  title = {Advancements in Soil Moisture Estimation through Integration of Remote Sensing and Artificial Intelligence Techniques},
  author = {P, Harani and Gautam, Sneha and Joshi, Suneel Kumar and Asirvatham, Lazarus Godson and Rakshith, Bairi Levi},
  year = 2025,
  month = oct,
  journal = {Science of The Total Environment},
  volume = {1001},
  pages = {180503},
  issn = {0048-9697},
  doi = {10.1016/j.scitotenv.2025.180503},
  urldate = {2026-07-07},
  abstract = {Soil moisture plays a vital role in crop productivity, ecosystem function, climate feedback, and groundwater recharge, yet it remains one of the least directly measured hydrological and hydrogeological variables. Its limitations in spatial coverage, depth sensitivity, and real-time monitoring hinder the soil moisture estimation methods. This review presents a comprehensive overview of recent advancements in soil moisture estimation techniques, covering traditional in-situ, remote sensing, and AI-based methods. A comparative evaluation highlights these methods' operational mechanisms, spatial limitations, and potential synergies with region-specific insights. It also summarizes approaches such as cosmic-ray neutron sensing, Global Navigation Satellite System (GNSS) reflectometry, Synthetic Aperture Radar (SAR) based methods, and multi-sensor data fusion for large-scale surface soil moisture estimation. The present study highlights the key challenges, such as physical interpretability, transparency, and model transferability in AI-based models due to their black-box nature. Incorporation of remote sensing with explainable AI further enhances the performance, trustworthiness, and reliability of the model. In addition, integrating multi-sensor data with in-situ data, machine/deep learning, and physical models enhances the accuracy, spatial and temporal resolution, continuous data availability, and root zone soil moisture estimation. Further research is required in uncertainty handling, evaluating, validating, and improving the transferability of the model across diverse regions. Through citizen science and crowdsourcing, real-time soil moisture monitoring in the data-scarce areas can be achieved. The study concludes by outlining future directions for scalable, interpretable monitoring systems and developing robust systems to support sustainable water resource management and climate-resilient agriculture.},
  keywords = {agriculture,Agriculture,artificial intelligence,Artificial intelligence,Artificial intelligence techniques,Climate feedbacks,comparative study,controlled study,cosmic radiation,Cosmology,Crop productivity,crowdsourcing,Data fusion,Data integration,deep learning,Deep learning,Distributed computer systems,Ecosystem functions,Ecosystems,explainable artificial intelligence,global navigation satellite system,GNSS,ground water,Ground water recharge,Groundwater,Hydrogeology,Hydrological monitoring,Learning systems,machine learning,moisture,monitoring,nonhuman,physical model,plant root,reflectometry,reliability,remote sensing,Remote sensing,Remote-sensing,review,sensor,Sensor data fusion,soil moisture,Soil moisture,Soil moisture estimation,Soil surveys,surface soil,synthetic aperture radar,trustworthiness,Water conservation,water supply},
  file = {C\:\\Users\\lenka\\Zotero\\storage\\ENJ3UA8D\\P et al. - 2025 - Advancements in soil moisture estimation through integration of remote sensing and artificial intell.pdf;C\:\\Users\\lenka\\Zotero\\storage\\J5DKZXEY\\S0048969725021436.html}
}

@inproceedings{Pablos2025,
  title = {Advances in {{Soil Moisture Mapping Techniques}} and {{Disaggregation Algorithms}} for {{Environmental}} and {{Agricultural Applications}}},
  booktitle = {Int. {{Arch}}. {{Photogramm}}., {{Remote Sens}}. {{Spat}}. {{Inf}}. {{Sci}}. - {{ISPRS Arch}}.},
  author = {Pablos, Miriam and Portal, Gerard and Camps, Adriano and {Vall-Llossera}, Merc{\`e} and {L{\'o}pez-Mart{\'i}nez}, Carlos},
  year = 2025,
  volume = {48},
  pages = {1139--1146},
  publisher = {{International Society for Photogrammetry and Remote Sensing}},
  doi = {10.5194/isprs-archives-XLVIII-G-2025-1139-2025},
  abstract = {Soil moisture (SM) is a critical variable for understanding the water cycle, climate change, and agricultural management. This paper reviews advanced remote sensing techniques and disaggregation algorithms for high-resolution SM mapping, focusing on environmental and agricultural applications in North Africa and the UAE. Remote sensing methods, including optical sensors (e.g., Apparent Thermal Inertia, Temperature Vegetation Dryness Index), active microwave sensors (scatterometers, Synthetic Aperture Radar), and passive microwave radiometers (SMOS, SMAP), are evaluated for their ability to map SM at varying spatial and temporal scales. Despite advancements, coarse resolution remains a challenge for regional applications. To address this, two innovative downscaling algorithms are presented: the SMOS Semi-Empirical Method, which fuses SMOS data with ECMWF skin temperature and MODIS/Sentinel-3 NDVI to achieve 1 km and 300 m resolutions, and the Artificial Neural Network (ANN) Method, leveraging multi-sensor data to produce 60 m resolution SM maps. These algorithms have been validated across diverse environments, demonstrating RMSE values of 0.04-0.10 cm3/cm3 The case studies  studies presented highlight their operational utility in flash flood monitoring (Algeria, Tunisia, UAE), ecosystem dynamics (Chott el Djerid, Tunisia), and precision agriculture (East Oweinat, Egypt). Future work includes the integration of multi-sensor data, to enhance machine learning models, and the improvement of SM measurements at deeper soil layers to support applications in arid regions. \copyright{} Author(s) 2025.},
  langid = {english},
  keywords = {Agricultural machinery,Climate change,Disaggregation,Disaggregation algorithm,disaggregation algorithms,Ecosystems,environmental monitoring,Environmental Monitoring,Image resolution,Learning systems,Machine learning,Mapping,Mapping techniques,Meteorological instruments,Microwave devices,moisture,Multi-sensor data,Neural networks,Precision agriculture,Radiometers,remote sensing,Remote sensing,Remote-sensing,Soil moisture,Soil moisture mapping,Soil surveys,spatial resolution,Spatial resolution,Tunisia},
  file = {C\:\\Users\\lenka\\Zotero\\storage\\L7VYI5KX\\Pablos et al. - 2025 - Advances in Soil Moisture Mapping Techniques and Disaggregation Algorithms for Environmental and Agr.pdf;C\:\\Users\\lenka\\Zotero\\storage\\CB9TAWGQ\\105014314341.html}
}

