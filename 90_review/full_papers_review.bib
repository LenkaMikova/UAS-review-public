@article{kambleREVIEWANALYSISREMOTE2024,
  title = {A {{REVIEW ANALYSIS ON REMOTE CROP MOISTURE MONITORING SYSTEM}}},
  author = {Kamble, S.; Powar, N.; Kadam, A.B., A.; Jain},
  year = 2024,
  journal = {IET Conference Proceedings},
  volume = {2024},
  number = {38 status  - correct\_record is\_review  - True sensor\_type  - platform  - observation\_method  - RS sensor\_mode  - application\_domain  - agriculture methodology  - irrigation, precision agriculture scaling  - uav\_applicability  - False uav\_potential  - False uav\_relevance  - none relevance\_score  - 3 must\_cite  - False must\_cite\_strict  - False screening\_decision  - maybe},
  pages = {347--349},
  doi = {10.1049/icp.2025.0811},
  abstract = {Improving agricultural output and optimizing irrigation methods depend on precise and timely crop moisture monitoring. The goal of this project is to develop a remote crop moisture monitoring system that overcomes the drawbacks of existing methods and provides a more effective and scalable alternative. To collect thorough data on soil conditions in real time, the system integrates a range of sensor technologies, such as temperature, humidity, and soil moisture sensors. Wireless transmission of data from these sensors is made to a central platform for analysis and viewing. The ESP8266 module facilitates wireless communication and guarantees dependable data transfer over extended distances. The central platform processes the incoming data using modern data analytics and machine learning techniques, providing farmers with predictive analytics and useful insights. With the use of insights, farmers can schedule irrigation more effectively, use water more efficiently, and avoid over- or underwatering their crops. Farmers can monitor their fields remotely thanks to the system's user-friendly interface, which offers real-time warnings and comprehensive reports that can be accessed via PCs or mobile devices. The ultimate objective of this research is to enhance sustainable agriculture by optimizing agricultural output and water resource utilization. This system seeks to increase crop yields, decrease water waste, and contribute to the overall sustainability of farming methods by offering a reliable and effective crop moisture monitoring solution. \copyright{} The Institution of Engineering \& Technology 2024.},
  langid = {english},
  keywords = {Agricultural output,Agricultural robots,Humidity control,Irrigation,Irrigation methods,Moisture monitoring,Monitoring system,Precision Agriculture,Real- time,Remote Sensing,Remote-sensing,Sensor technologies,Soil conditions,Soil moisture monitoring,Soil Moisture Monitoring}
}

@article{Karthikeyan2020,
  title = {A Review of Remote Sensing Applications in Agriculture for Food Security: {{Crop}} Growth and Yield, Irrigation, and Crop Losses},
  shorttitle = {A Review of Remote Sensing Applications in Agriculture for Food Security},
  author = {Karthikeyan, L. and Chawla, Ila and Mishra, Ashok K.},
  year = 2020,
  month = jul,
  journal = {Journal of Hydrology},
  volume = {586},
  pages = {124905},
  issn = {0022-1694},
  doi = {10.1016/j.jhydrol.2020.124905},
  urldate = {2026-07-07},
  abstract = {The global population is expected to reach 9.8 billion by 2050. There is an exponential growth of food production to meet the needs of the growing population. However, the limited land and water resources, climate change, and an increase in extreme events likely to pose a significant threat for achieving the sustainable agriculture goal. Given these challenges, food security is included in the United Nations' Sustainable Development Goals (SDGs). Since the advent of Sputnik, followed by the Explorer missions, satellite remote sensing is assisting us in collecting the data at global scales. In this work, we review how satellite remote sensing information is utilized to assess and manage agriculture, an important component of ecohydrology. Overall, three critical aspects of agriculture are considered: (a) crop growth and yield through empirical models, physics-based models, and data assimilation in crop models, (b) applications pertaining to irrigation, which include mapping irrigation areas and quantification of irrigation, and (c) crop losses due to pests, diseases, crop lodging, and weeds. The emphasis is on satellite sensors in optical, thermal, microwave, and fluorescence frequencies. We conclude the review with an outlook of challenges and recommendations. This paper is the first of a two-part review series. The second part reviews the role of satellite remote sensing in water security, wherein we discuss the aspects of water quality and quantity along with extremes (floods and droughts).},
  keywords = {Agriculture,Crop losses,Crop yield,Data assimilation,DATA ASSIMILATION,Irrigation,LEAF-AREA INDEX,MODIS TIME-SERIES,PADDY-RICE,Remote sensing,USE/LAND-COVER LULC,VEGETATION OPTICAL DEPTH,WATER-STRESS INDEX,WAVE RADAR BACKSCATTERING,X-BAND SAR,ZONE SOIL-MOISTURE},
  file = {C\:\\Users\\lenka\\Zotero\\storage\\FQHPH2JB\\Karthikeyan et al. - 2020 - A review of remote sensing applications in agriculture for food security Crop growth and yield, irr.pdf;C\:\\Users\\lenka\\Zotero\\storage\\NET736F9\\S0022169420303656.html}
}

