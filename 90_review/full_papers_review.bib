@article{Wadod2023,
  title = {Review on {{Drone}} Application Methodologies in Agriculture Precision},
  author = {Wadod, Mohammed M. and Mohammed, Faisel G.},
  year = 2023,
  month = jun,
  journal = {IOP Conference Series: Earth and Environmental Science},
  volume = {1202},
  number = {1},
  pages = {012001},
  publisher = {IOP Publishing},
  issn = {1755-1315},
  doi = {10.1088/1755-1315/1202/1/012001},
  urldate = {2026-07-28},
  abstract = {In recent times, Drone use has increased significantly in the field of precise agriculture. These aircraft, which are equipped with thermal and multi-spectrum cameras, allow us to increase agricultural production in proportion to the increasing demand of the population and monitor crops grown in large areas, which is a very difficult task given the large areas of fields and the standards required for the successful cultivation of the crop in terms of soil moisture and fertility, proximity to water sources, and the possibility of its delivery In a way that reduces the waste of this water. Fields are at risk of crop damage due to diseases to crops caused by insects and pests, as drones can be used to spray pesticides and fertilizers in a way that reduces the health risks to people when spreading them manually. In this research paper, we will address several previous research related to the use of sensor and drone techniques in the field of precision agriculture and their efficiency in helping to sustain production and increase crop yields.},
  langid = {english},
  keywords = {Drone,high precision areal,Precision Agriculture,satellite image interpretation},
  file = {C:\Users\lenka\Zotero\storage\X2YHGAWD\Wadod and Mohammed - 2023 - Review on Drone application methodologies in agriculture precision.pdf}
}

