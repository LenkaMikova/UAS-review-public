@article{Niu2020,
  title = {Evapotranspiration Estimation with Small Uavs in Precision Agriculture},
  author = {Niu, Haoyu and Hollenbeck, Derek and Zhao, Tiebiao and Wang, Dong and Chen, Yangquan},
  year = 2020,
  journal = {Sensors (Switzerland)},
  volume = {20},
  number = {22},
  pages = {1--28},
  publisher = {MDPI AG},
  issn = {1424-8220},
  doi = {10.3390/s20226427},
  abstract = {Estimating evapotranspiration (ET) has been one of the most critical research areas in agriculture because of water scarcity, the growing population, and climate change. The accurate estimation and mapping of ET are necessary for crop water management. Traditionally, researchers use water balance, soil moisture, weighing lysimeters, or an energy balance approach, such as Bowen ratio or eddy covariance towers to estimate ET. However, these ET methods are point-specific or area-weighted measurements and cannot be extended to a large scale. With the advent of satellite technology, remote sensing images became able to provide spatially distributed measurements. However, the spatial resolution of multispectral satellite images is in the range of meters, tens of meters, or hundreds of meters, which is often not enough for crops with clumped canopy structures, such as trees and vines. Unmanned aerial vehicles (UAVs) can mitigate these spatial and temporal limitations. Lightweight cameras and sensors can be mounted on the UAVs and take high-resolution images. Unlike satellite imagery, the spatial resolution of the UAV images can be at the centimeter-level. UAVs can also fly on-demand, which provides high temporal imagery. In this study, the authors examined different UAV-based approaches of ET estimation at first. Models and algorithms, such as mapping evapotranspiration at high resolution with internalized calibration (METRIC), the two-source energy balance (TSEB) model, and machine learning (ML) are analyzed and discussed herein. Second, challenges and opportunities for UAVs in ET estimation are also discussed, such as uncooled thermal camera calibration, UAV image collection, and image processing. Then, the authors share views on ET estimation with UAVs for future research and draw conclusive remarks. \copyright{} 2020 by the authors. Licensee MDPI, Basel, Switzerland.},
  langid = {english},
  keywords = {Agricultural robots,agriculture,Agriculture,aircraft,Aircraft,Antennas,Calibration,Cameras,Climate change,Clumped canopy,crop,Crop water managements,Crops,Crops Agricultural,Distributed measurements,Eddy covariance towers,Energy balance,evapotranspiration,Evapotranspiration,High resolution image,Image processing,Image resolution,Machine learning,Mapping,METRIC,Models and algorithms,Multispectral satellite image,physiology,Plant Transpiration,Precision agriculture,remote sensing,Remote sensing,Remote sensing images,Remote Sensing Technology,Satellite imagery,Satellite technology,Scales (weighing instruments),soil,Soil,Soil moisture,Unmanned aerial vehicles,Unmanned aerial vehicles (UAV),Water management},
  file = {C:\Users\lenka\Zotero\storage\2HZ6DVF9\85096035498.html}
}

@article{Niu2022,
  title = {Estimating {{Evapotranspiration}} of {{Pomegranate Trees Using Stochastic Configuration Networks}} ({{SCN}}) and {{UAV Multispectral Imagery}}},
  author = {Niu, Haoyu and Zhao, Tiebiao and Wang, Dong and Chen, YangQuan},
  year = 2022,
  journal = {Journal of Intelligent and Robotic Systems: Theory and Applications},
  volume = {104},
  number = {4},
  publisher = {{Springer Science and Business Media B.V.}},
  issn = {0921-0296},
  doi = {10.1007/s10846-022-01588-2},
  abstract = {Evapotranspiration (ET) estimation is important in precision agriculture water management, such as evaluating soil moisture, drought monitoring, and assessing crop water stress. As a traditional method, evapotranspiration estimation using crop coefficient (Kc) has been commonly used. Since there are strong similarities between the Kc curve and the vegetation index curve, the crop coefficient Kc is usually estimated as a function of the vegetation index. Researchers have developed linear regression models for the Kc and the normalized difference vegetation index (NDVI), usually derived from satellite imagery. However, the spatial resolution of the satellite image is often insufficient for crops with clumped canopy structures, such as vines and trees. Therefore, in this article, the authors used Unmanned Aerial Vehicles (UAVs) to collect high-resolution multispectral imagery in a pomegranate orchard located at the USDA-ARS, San Joaquin Valley Agricultural Sciences Center, Parlier, CA. The Kc values were measured from a weighing lysimeter and the NDVI values were derived from UAV imagery. Then, the authors established a relationship between the NDVI and Kc by using a linear regression model and a stochastic configuration networks (SCN) model, respectively. Based on the research results, the linear regression model has an R2 of 0.975 and RMSE of 0.05. The SCN regression model has an R2 and RMSE value of 0.995 and 0.046, respectively. Compared with the linear regression model, the SCN model improved performance in predicting Kc from NDVI. Then, actual evapotranspiration was estimated and compared with lysimeter data in an experimental pomegranate orchard. The UAV imagery provided a spatial and tree-by-tree view of ET distribution. \copyright{} 2022, The Author(s).},
  langid = {english},
  keywords = {Evapotranspiration,NDVI,SCNs,Unmanned aerial vehicles},
  file = {C:\Users\lenka\Zotero\storage\8T8ANUCI\85127451397.html}
}

@article{Niu2025,
  title = {Quantitative {{Analysis}} of the {{Relationship Between Maize Seedling Phenotypes}} and {{Soil Moisture Monitored}} by {{UAV RGB Imagery}}},
  author = {Niu, Shanwei and Nie, Zhigang and Li, Guang and Zhu, Wenyu and Liu, Jiayu},
  year = 2025,
  month = jul,
  journal = {IEEE Sensors Journal},
  volume = {25},
  number = {13},
  pages = {24387--24395},
  issn = {1558-1748},
  doi = {10.1109/JSEN.2025.3569297},
  urldate = {2026-05-27},
  abstract = {Traditional plant phenotyping methods are typically constrained by several key limitations: insufficient segmentation accuracy, high computational costs, lack of multi-scale analysis capabilities, and ineffective modeling of complex nonlinear relationships. This study utilizes RGB imagery captured by uncrewed aerial vehicles (UAVs), integrating plant phenotypic traits with soil moisture data, to quantitatively analyze the relationship between maize seedling phenotypes and soil moisture. Key morphological features of maize leaves---including connectivity, length, area, and shape characteristics---were transformed into matrix data using image segmentation, edge detection, and the whale optimization algorithm (WOA). A quantitative relationship model between maize seedling phenotypes and soil moisture was established via regression analysis. To enhance segmentation accuracy further, we introduced the large selective kernel network (LSKNet) module into YOLOv8, which optimizes leaf segmentation performance significantly under varying moisture stress conditions through multi-scale feature fusion and selective kernel convolution. The regression analysis results indicate high predictive accuracy under optimal moisture conditions (moisture content between 0.647 and 0.813), with an R\textasciicircum 2 of 0.869 and an RMSE of 0.0256. However, under drought conditions (moisture content between 0.246 and 0.354), prediction accuracy declines, with R\textasciicircum 2 decreasing to 0.851 and RMSE increasing to 0.0272. This study generates drought severity heatmaps using imagery from UAV, providing an efficient visualization tool for assessing maize plant health status. These heatmaps offer valuable references for early drought detection and precision irrigation decision-making, significantly advancing crop health management and the development of precision agriculture.},
  keywords = {Autonomous aerial vehicles,Computational modeling,Crops,Deep learning,Droughts,Feature extraction,Image edge detection,multi-scale fusion regression analysis,Phenotypes,plant phenotype,soil moisture,Soil moisture,uncrewed aerial vehicle (UAV),Water resources,Whales},
  file = {C:\Users\lenka\Zotero\storage\YVC2PC5U\11018811.html}
}

