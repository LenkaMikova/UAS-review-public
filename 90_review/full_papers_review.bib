@article{bertottoSoilMoistureDroughtNexus2025,
  title = {Soil {{Moisture-Drought Nexus}} across {{Brazil}}: {{Identifying Current Issues}} and {{Future Perspectives}}},
  author = {Bertotto, H.K.; Alves Vasconcelos, P.E.; De Ara{\'u}jo, I.L.; Wendland, E.C., L.E.; De Medeiros Costa},
  year = 2025,
  journal = {Journal of Water Resources Planning and Management},
  volume = {151},
  number = {8 status  - correct\_record is\_review  - True sensor\_type  - platform  - observation\_method  - RS sensor\_mode  - application\_domain  - agriculture methodology  - water management scaling  - uav\_applicability  - False uav\_potential  - False uav\_relevance  - none relevance\_score  - 3 must\_cite  - False must\_cite\_strict  - False screening\_decision  - maybe},
  doi = {10.1061/JWRMD5.WRENG-6575},
  abstract = {Droughts impact ecosystem activity, water security, and energy production. Recent studies have advanced the understanding of current drought periods and projected expectations for these events in a future of climate change. However, the relationship between droughts and soil moisture (SM)-a key variable in global ecology-remains poorly understood. Therefore, addressing the soil moisture-drought nexus is crucial for water and natural resources management. This endeavor may be particularly challenging in tropical regions like Brazil, a continental-scale country that harbors extensive biodiversity. To bridge this gap, we conducted a state-of-The-Art review investigating the soil moisture-drought nexus across Brazil under current and future scenarios. The review findings indicate that SM behavior varies between different Brazilian biomes and regions under water scarcity. Nevertheless, a strong seasonality in SM was detected, suggesting the intensification of drought events in both current and future conditions. Furthermore, several Brazilian crops may become vulnerable in a drier climate, highlighting the urgent need to optimize water use in agriculture while maintaining crop productivity. Given the challenge of water scarcity, it is also essential to adopt strategies that balance agricultural land use with the conservation of natural vegetation, as these often intersect. Based on assessments of the soil moisture-drought nexus with methods ranging from remote sensing products to ground-based data, we concluded that national-scale analyses are valuable for decision-making and resource provision, while field investigations improve the understanding of the physical mechanisms behind land-Atmosphere interactions. Our conclusions underscore the necessity of considering soil moisture as an independent variable in future studies, rather than relying on proxies, as it plays a unique role within the climatological and hydrological systems. We believe that the findings of this review can help improve soil water management under drought conditions not only in Brazil but also in Earth's tropical zone as a whole. \copyright{} 2025 American Society of Civil Engineers.},
  langid = {english},
  keywords = {'current,biodiversity,Brazil,climate change,Decision making,drought,Drought periods,ecosystem response,Energy productions,Future perspectives,future prospect,Global warming,Key variables,moisture,remote sensing,Resource management,Silt,soil moisture,Soil moisture,soil water,Water energy,water management,Water management,Water scarcity,Water security}
}

@article{Bhatti2020,
  title = {Site-Specific Irrigation Management in a Sub-Humid Climate Using a Spatial Evapotranspiration Model with Satellite and Airborne Imagery},
  author = {Bhatti, Sandeep and Heeren, Derek M. and Barker, J. Burdette and Neale, Christopher M. U. and Woldt, Wayne E. and Maguire, Mitchell S. and Rudnick, Daran R.},
  year = 2020,
  month = mar,
  journal = {Agricultural Water Management},
  volume = {230},
  pages = {105950},
  issn = {0378-3774},
  doi = {10.1016/j.agwat.2019.105950},
  urldate = {2026-06-22},
  abstract = {Variable Rate Irrigation (VRI) considers spatial variability in soil and plant characteristics to optimize irrigation management in agricultural fields. The advent of unmanned aircraft systems (UAS) creates an opportunity to utilize high-resolution (spatial and temporal) imagery into irrigation management due to decreasing costs, ease of operation, and reduction of regulatory constraints. This research aimed to evaluate the use of UAS data for VRI, and to quantify the potential of VRI in terms of relative crop and water response. Irrigation treatments were: (1) VRI using Landsat imagery (VRI-L), (2) VRI using UAS imagery (VRI-U), (3) uniform (U), and (4) rainfed (R). An updated remote-sensing-based evapotranspiration and water balance model, incorporating soil water measurements, was used to make prescriptions for the VRI treatments at a field site in eastern Nebraska. In 2017, the mean prescribed seasonal irrigation depth (Ip) for VRI-L was significantly greater ({$\alpha$}\,=\,0.05) than the Ip for U for soybean. In 2018, Ip for soybean was greatest for VRI-U treatment followed by the U and VRI-L treatments, with all being significantly different from each other. No significant differences in Ip for maize were observed in 2017 or 2018. In all crop-year combinations, the VRI and U treatments had significantly greater evapotranspiration (ET) than the R treatment. Yield differences among treatments were not significant (except for rainfed maize compared to VRI-L in 2017). For maize in 2017, IWUE for VRI-L was comparable to the U treatment. The UAS imagery was a better match for the scale of crop management than Landsat imagery, particularly for thermal data. The multispectral UAS data was successfully used in the crop coefficient ET model for real-time irrigation, but using UAS to determine accurate canopy temperatures for surface energy balance modeling remains a challenge.},
  keywords = {Evapotranspiration,Remote sensing,Soil water content,Spatial variability,Unmanned aircraft systems,Variable rate irrigation},
  file = {C:\Users\lenka\Zotero\storage\BEU4LAN3\S0378377419309552.html}
}

@inproceedings{Bhavana2025,
  title = {Integrated {{Deep Learning Framework}} for {{Precision Crop Yield Prediction Using Satellite Imagery}} and {{Real-Time Environmental Data}}},
  booktitle = {2025 3rd {{International Conference}} on {{Communication}}, {{Security}}, and {{Artificial Intelligence}} ({{ICCSAI}})},
  author = {Bhavana, Kadaveru and Rishika, Mamidi and R, Kanchana and Samhitha, Deram and Deekshitha, Dosapati and Vaishnavi, Kadari},
  year = 2025,
  month = apr,
  volume = {3},
  pages = {1278--1283},
  doi = {10.1109/ICCSAI64074.2025.11063779},
  urldate = {2026-07-29},
  abstract = {Crop yield prediction is an important for global food security, particularly in a climate of growing populations, resource constraints, and a changing climate. Traditional methods of crop yield prediction have proven inaccurate, as crop types, agricultural practices, and environmental factors interact complexly. New advances in machine learning, satellite technology, and sensor-based data collection are expected to have a high degree of success in increasing the precision of crop yield predictions. This paper reviews and offers an integrated approach for predicting crop yield using deep learning models combined with satellite imagery along with real-time environmental data. We discuss major algorithms involved in processing and analyzing big data to improve precision in crop yield prediction using techniques including ANN, LSTM, and CNN. We also provide an approach that integrates the use of ensemble models and climate data along with precision agriculture technologies in optimizing resource utilization and better farming practices. The proposed model combines several data sources on weather condition, soil moisture levels, and satellite imaging to ensure scalability and sustainability that crop yield forecasting lacks. Further directions also include genetic engineering, nanotechnology, and reinforcement learning for refinement of the predictive models leading to further development in sustainability in agricultural production.},
  keywords = {Agricultural machinery,ANN (Artificial Neural Networks),Artificial neural network,Big data,CNN (Convolution Neural Networks),Convolution neural network,Convolutional neural networks,Crop yield,Crops,Data models,Deep learning,Deep Learning,Deep neural networks,Ensemble Model,Ensemble models,Forecasting,Genetic engineering,Genetic Engineering,Learning systems,Long short term memory,Long-short term memory,LSTM (Long-Short Term Memory),Meteorology,Nanotechnology,Neural-networks,Precision agriculture,Predictive models,Real-time systems,Reinforcement Learning,Reinforcement learnings,Satellite imagery,Satellite images,Short term memory,Sustainable development},
