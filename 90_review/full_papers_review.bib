@article{rananavareOptimizingAgricultureArid2025,
  title = {Optimizing {{Agriculture}} in {{Arid}} and {{Semi-Arid Region Using Remote Sensing}}: {{A}} Review},
  author = {Rananavare, D.C.; Prasad, A.R.; Hegde, A.; Pavan, B.N., L.B.; Saravana Kumar},
  year = 2025,
  journal = {2025 IEEE International Conference on Emerging Technologies and Applications, MPSec ICETA 2025},
  doi = {10.1109/MPSecICETA64837.2025.11118302},
  abstract = {Arid and semi-arid regions cover a significant portion of the Earth's surface, characterized by limited water resources and vulnerable ecosystems. Efficient agricultural management in these regions is crucial to mitigate the impacts of climate change, desertification, and soil degradation. This review explores the integration of remote sensing and machine learning technologies to enhance agricultural productivity in water-scarce environments. Satellite-based techniques, such as vegetation indices (NDVI, EVI) and spectral mixture analysis, provide large-scale monitoring of vegetation health and surface dryness. Coupled with advanced machine learning models like Random Forest and Convolutional Neural Networks, these technologies enable precise crop yield predictions, soil moisture mapping, and optimized irrigation practices. Despite progress, challenges remain in data quality, model accuracy, and realtime adaptability, particularly in heterogeneous landscapes. This paper highlights current methodologies, their applications, and the potential for improved resource management, aiming to support sustainable agricultural practices in dryland regions.  \copyright{} 2025 IEEE.},
  langid = {english},
  keywords = {Agricultural machinery,ANN,Arid and semi-arid regions,Arid and Semi-Arid Regions,Arid regions,Aridity index,Aridity Index,Climate change,DQN,Ecosystems,Learning systems,LSTM,Machine learning,Machine Learning,Machine-learning,NDVI,NDWI,Neural networks,Precision agriculture,Precision Agriculture,Random Forest,Random forests,Remote sensing,Remote Sensing,Remote-sensing,SAR,Soil moisture,Soil surveys,Speckle filtering,Speckle Filtering,Time series,Time Series,Times series,Vegetation,Water resources,Xgboost,XGBoost}
}

