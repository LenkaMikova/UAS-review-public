@article{Pippi2025,
  title = {Use of {{Digital Technologies}} into {{Agroforestry Systems}}: {{A Review}}},
  shorttitle = {Use of {{Digital Technologies}} into {{Agroforestry Systems}}},
  author = {Pippi, Lorenzo and Alibani, Michael and Antichi, Daniele and Caruso, Giovanni and Finocchi, Matteo and Fontanelli, Marco and Moretti, Michele and Nali, Cristina and Pellegrini, Elisa and Peruzzi, Andrea and Ripamonti, Alice and Risoli, Samuele and Silvestri, Nicola and Tramacere, Lorenzo Gabriele and Cotrozzi, Lorenzo},
  year = 2025,
  journal = {Agronomy},
  volume = {15},
  number = {12},
  publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
  issn = {2073-4395},
  doi = {10.3390/agronomy15122671},
  abstract = {Agroforestry, an integrated land-use practice combining trees and woody shrubs with crop and animal farming, offers significant ecological and agricultural benefits, including enhanced biodiversity, improved soil fertility, and increased resilience to environmental pressures. Despite its advantages, agroforestry faces challenges such as high initial investments, long maturation periods for trees, land tenure issues and a high level of complexity in technical management. Digital agriculture introduces advanced technologies and sensors, which provide precise data on soil moisture, nutrient levels, and plant health, enabling more efficient resource use and better farm management. Integrating these sensing technologies into agroforestry can address key challenges, optimize irrigation and nutrient management, and enhance overall system productivity and sustainability. This review explores the interaction between agroforestry and digitalization, highlighting case studies, and discusses the potential for these technologies to support sustainable agriculture and climate change mitigation. Increased investment in research and development, along with supportive policies, is essential for advancing the adoption of these innovative practices in agroforestry. \copyright{} 2025 by the authors.},
  langid = {english},
  keywords = {advanced sensing technologies,agroforestry,alternative agriculture,biodiversity,carbon sequestration,climate change,climate change mitigation,farming system,integrated approach,integrated farming systems,land use change,precision agriculture,remote sensing,sensors,soil fertility,sustainable agriculture,woody plant},
  file = {C:\Users\lenka\Zotero\storage\TXXQDQEV\105027398726.html}
}

