@article{lekhaIntegratingIntelligentAgents2025,
  title = {Integrating {{Intelligent Agents}} in {{Smart Irrigation Systems}} for {{Sustainable Paddy Cultivation}}},
  author = {Lekha, P., D.; Valarmathie},
  year = 2025,
  journal = {2025 2nd International Conference on Computing and Data Science, ICCDS 2025},
  doi = {10.1109/ICCDS64403.2025.11209612},
  abstract = {Water is a major component in the development of crops especially in paddy farming and this necessitates effective management of water in the agricultural sector. The conventional irrigation can be associated with inefficiency of water use, loss of nutrients and water erosion of the soil. This paper gives an extensive review of the smart drip irrigation systems based on intelligent agents which are suitable in paddy fields. It explores the incorporation of intelligent agent, sensor networks, and IoT-based technologies in order to make data-based real-time irrigation decisions. The paper looks at the main elements including the soil moisture sensors, communication protocols and AI/ML-based controllers that allow accurate delivery of water according to the needs of the crops. Comparisons of conventional systems and smart systems are given, and they are based on such parameters as water-use efficiency, crop yield, and energy savings. Hurdles such as reliability of sensors, financial constraints, infrastructure restrictions and data uncertainty are also explored. Future directions discussed in the paper include integration of adaptive learning agents, drones and edge computing as a way of improving system performance further. In the light of interdisciplinary cooperation and governmental assistance, this survey proposes that the use of intelligent irrigation system should be popularized to ensure sustainable agriculture and preservation of resources in paddy cultivation. \copyright{} 2025 IEEE.},
  langid = {english},
  keywords = {Agricultural sector,Crops,Cultivation,Drip irrigation,Drip Irrigation,Effective management,Energy efficiency,Intelligent agents,Intelligent Agents,Irrigation systems,Learning systems,Paddy cultivation,Paddy Cultivation,Precision agriculture,Precision Agriculture,Smart agriculture,Smart irrigation,Smart Irrigation,Subirrigation,Water conservation,Water erosion,Water management,Water use,Waters managements}
}

