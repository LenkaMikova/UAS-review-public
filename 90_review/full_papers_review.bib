@article{Dong2024,
  title = {Crop Water Stress Detection Based on {{UAV}} Remote Sensing Systems},
  author = {Dong, Hao and Dong, Jiahui and Sun, Shikun and Bai, Ting and Zhao, Dongmei and Yin, Yali and Shen, Xin and Wang, Yakun and Zhang, Zhitao and Wang, Yubao},
  year = 2024,
  journal = {Agricultural Water Management},
  volume = {303},
  publisher = {Elsevier B.V.},
  issn = {0378-3774},
  doi = {10.1016/j.agwat.2024.109059},
  abstract = {Agricultural water accounts for more than 70 \% of the total global water usage, and the scarcity of global freshwater resources will largely limit global agricultural production. Precision irrigation is the key to improving water efficiency and achieving sustainable agriculture. Accurate and rapid access to crop water information is an essential prerequisite for precise irrigation decisions. Traditional moisture detection methods based on soil moisture and crop physiological parameters are faced with the problems of variable field conditions, low efficiency and lack of spatial information, which can be extremely limited in practical applications. By contrast, unmanned aerial vehicle (UAV) remote sensing has the advantages of low cost, small size, flexible data acquisition time, and easy acquisition of high-resolution image data. Therefore, UAV remote sensing has become an easy and efficient method for crop water information monitoring. This study systematically introduces the principles, methods and applications of crop water stress analysis using the UAV technology. First, the mechanism of crop water stress analysed by UAV is elaborated, focusing on the relationship between canopy temperature, evapotranspiration, sun-induced chlorophyll fluorescence (SIF) and crop water stress. Next, various UAV imaging technologies for crop water stress monitoring are presented, including optical sensing systems, red, green and blue (RGB) images, multi-spectral sensing systems, and hyper-spectral sensing systems. Subsequently, the application of machine learning algorithms in the field of UAV monitoring of crop water information is outlined, demonstrating their potential for data processing and analysis. Finally, new directions and challenges in UAV-based crop water information acquisition and processing are synthesised and discussed, with special emphasis on the prospects of data assimilation algorithms and non-stomatal restriction in monitoring crop water information in the future. This study provides a comprehensive comparison and assessment of the mechanisms, technologies and challenges of UAV-based crop water information monitoring, providing insights and references for researchers in related fields. \copyright{} 2024 The Authors},
  langid = {english},
  keywords = {Aerial vehicle,canopy,Crop water stress,CWSI,data acquisition,data assimilation,evapotranspiration,Fertilizers,fluorescence,Hyper-spectral,HyperSpectral,chlorophyll,machine learning,Multi-spectral,Network security,Optical,Optical remote sensing,Optical-,Red green and blue,remote sensing,Remote-sensing,RGB,Soil moisture,UAV,Unmanned aerial vehicle,Unmanned aerial vehicles (UAV),unmanned vehicle,Water informations,water stress},
  file = {C:\Users\lenka\Zotero\storage\8FGD8JPK\85203642133.html}
}

